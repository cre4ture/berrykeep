load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Keep Cargo.toml as the dependency source of truth while exposing this leaf
# crate to Bazel's action graph. Downstream workspace crates can depend on this
# target as they are migrated.
rust_library(
    name = "common",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "common",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_test",
    size = "small",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":common",
    edition = crate_edition(),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)
