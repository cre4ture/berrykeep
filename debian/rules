#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export IRONMESH_PREBUILT_WEB_DIR := $(CURDIR)/debian/prebuilt-web
export CARGO_HOME := $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR := $(CURDIR)/target/debian
export CARGO_NET_OFFLINE := true

SERVER_NODE_ONLY := $(filter server-node-only,$(DEB_BUILD_PROFILES))

ifeq ($(IRONMESH_USE_PREBUILT_BINARIES),1)
PACKAGE_BIN_DIR := $(IRONMESH_PREBUILT_BIN_DIR)
SERVER_NODE_BIN := $(PACKAGE_BIN_DIR)/ironmesh-server-node
else
PACKAGE_BIN_DIR := $(CARGO_TARGET_DIR)/release
ifeq ($(IRONMESH_USE_PREBUILT_SERVER_NODE),1)
SERVER_NODE_BIN := $(IRONMESH_PREBUILT_SERVER_NODE_BIN)
SERVER_NODE_CARGO_PACKAGE :=
else
SERVER_NODE_BIN := $(PACKAGE_BIN_DIR)/ironmesh-server-node
SERVER_NODE_CARGO_PACKAGE := -p server-node
endif
endif

ifeq ($(SERVER_NODE_ONLY),server-node-only)
PACKAGE_BINARIES := ironmesh-server-node
CARGO_PACKAGE_ARGS :=
else
PACKAGE_BINARIES := \
	ironmesh-server-node \
	ironmesh-rendezvous-service \
	ironmesh \
	ironmesh-config-app \
	ironmesh-background-launcher \
	ironmesh-folder-agent \
	ironmesh-os-integration

CARGO_PACKAGE_ARGS := \
	$(SERVER_NODE_CARGO_PACKAGE) \
	-p cli-client \
	-p ironmesh-config-app \
	-p ironmesh-background-launcher \
	-p ironmesh-folder-agent \
	-p os-integration \
	-p rendezvous-service
endif

CARGO_BIN := $(firstword $(wildcard /usr/bin/cargo-1.91 /usr/bin/cargo-1.89 /usr/bin/cargo-1.85 /usr/bin/cargo $(HOME)/.cargo/bin/cargo))
RUSTC_BIN := $(firstword $(wildcard /usr/bin/rustc-1.91 /usr/bin/rustc-1.89 /usr/bin/rustc-1.85 /usr/bin/rustc $(HOME)/.cargo/bin/rustc))
CLANG_BIN := $(firstword $(wildcard /usr/bin/clang))
CLANGXX_BIN := $(firstword $(wildcard /usr/bin/clang++))

export CC := $(CLANG_BIN)
export CXX := $(CLANGXX_BIN)

CLIENT_PACKAGE_ROOT := $(CURDIR)/debian/ironmesh-client/usr/lib/ironmesh-client
CLIENT_EXTENSION_ROOT := $(CLIENT_PACKAGE_ROOT)/gnome-shell-extension/ironmesh-status@ironmesh.io

%:
	dh $@ --with sysuser

override_dh_clean:
	dh_clean -XCargo.toml.orig

ifeq ($(IRONMESH_USE_PREBUILT_BINARIES),1)
override_dh_auto_configure:
	test -n "$(PACKAGE_BIN_DIR)" || \
		(echo "missing IRONMESH_PREBUILT_BIN_DIR" >&2; exit 1)
	for binary in $(PACKAGE_BINARIES); do \
		test -x "$(PACKAGE_BIN_DIR)/$$binary" || \
			(echo "missing prebuilt package binary: $(PACKAGE_BIN_DIR)/$$binary" >&2; exit 1); \
	done

override_dh_auto_build:
	:
else
ifeq ($(SERVER_NODE_ONLY),server-node-only)
override_dh_auto_configure:
	test "$(IRONMESH_USE_PREBUILT_SERVER_NODE)" = "1" || \
		(echo "server-node-only builds require IRONMESH_USE_PREBUILT_SERVER_NODE=1" >&2; exit 1)
	test -x "$(SERVER_NODE_BIN)" || \
		(echo "missing prebuilt server-node binary: $(SERVER_NODE_BIN)" >&2; exit 1)

override_dh_auto_build:
	:
else
override_dh_auto_configure:
	if [ "$(IRONMESH_USE_PREBUILT_SERVER_NODE)" = "1" ]; then \
		test -x "$(SERVER_NODE_BIN)" || \
			(echo "missing prebuilt server-node binary: $(SERVER_NODE_BIN)" >&2; exit 1); \
	fi
	test -n "$(CLANG_BIN)" || \
		(echo "missing clang; install the Debian build dependencies" >&2; exit 1)
	test -n "$(CLANGXX_BIN)" || \
		(echo "missing clang++; install the Debian build dependencies" >&2; exit 1)
	test -f $(CURDIR)/debian/prebuilt-web/server-admin/index.html || \
		(echo "missing prebuilt server-admin assets; run ./scripts/prepare-ppa-source.sh" >&2; exit 1)
	test -f $(CURDIR)/debian/prebuilt-web/client-ui/index.html || \
		(echo "missing prebuilt client-ui assets; run ./scripts/prepare-ppa-source.sh" >&2; exit 1)
	test -d $(CURDIR)/debian/cargo-vendor || \
		(echo "missing vendored Rust dependencies; run ./scripts/prepare-ppa-source.sh" >&2; exit 1)
	test -f $(CURDIR)/debian/cargo-vendor/source-config.toml || \
		(echo "missing vendored Rust source configuration; run ./scripts/prepare-ppa-source.sh" >&2; exit 1)
	mkdir -p $(CARGO_HOME)
	sed 's|^directory = .*|directory = "$(CURDIR)/debian/cargo-vendor"|' \
		$(CURDIR)/debian/cargo-vendor/source-config.toml \
		> $(CARGO_HOME)/config.toml
	printf '%s\n' \
		'' \
		'[net]' \
		'offline = true' \
		>> $(CARGO_HOME)/config.toml

override_dh_auto_build:
	RUSTC=$(RUSTC_BIN) $(CARGO_BIN) build \
		--manifest-path $(CURDIR)/Cargo.toml \
		--locked \
		--offline \
		--release \
		$(CARGO_PACKAGE_ARGS)
endif
endif

override_dh_auto_test:
	# Skip the repository's long-running integration-heavy test suites during
	# package builds. The Launchpad PPA path is intended to validate that the
	# source package builds cleanly for the requested Ubuntu series.
	:

override_dh_shlibdeps:

ifeq ($(SERVER_NODE_ONLY),server-node-only)
	# The server-only profile accepts an already verified static musl artifact.
	# Avoid host-architecture ELF analysis when assembling an ARM package on an
	# x86 package runner, while still defining the substitution variable used by
	# the control file.
	grep -q '^shlibs:Depends=' debian/ironmesh-server-node.substvars 2>/dev/null || \
		printf '%s\n' 'shlibs:Depends=' >> debian/ironmesh-server-node.substvars
else
	dh_shlibdeps
	grep -q '^shlibs:Depends=' debian/ironmesh-server-node.substvars 2>/dev/null || \
		printf '%s\n' 'shlibs:Depends=' >> debian/ironmesh-server-node.substvars
endif

ifeq ($(SERVER_NODE_ONLY),server-node-only)
override_dh_dwz:
	# build-static-server-node.sh verifies and strips the static artifact before
	# packaging. Skipping both helpers avoids requiring foreign-architecture
	# binutils when an x86 builder assembles an ARM package wrapper.
	:

override_dh_strip:
	:

override_dh_makeshlibs:
	:
endif

override_dh_auto_install:
	install -d $(CURDIR)/debian/ironmesh-server-node/usr/bin
	install -m0755 $(SERVER_NODE_BIN) \
		$(CURDIR)/debian/ironmesh-server-node/usr/bin/ironmesh-server-node
	install -d $(CURDIR)/debian/ironmesh-server-node/etc/ironmesh
	install -m0644 debian/ironmesh-server-node.env \
		$(CURDIR)/debian/ironmesh-server-node/etc/ironmesh/server-node.env

ifeq ($(SERVER_NODE_ONLY),)
	install -d $(CURDIR)/debian/ironmesh-rendezvous-service/usr/bin
	install -m0755 $(PACKAGE_BIN_DIR)/ironmesh-rendezvous-service \
		$(CURDIR)/debian/ironmesh-rendezvous-service/usr/bin/ironmesh-rendezvous-service
	install -d $(CURDIR)/debian/ironmesh-rendezvous-service/etc/ironmesh
	install -m0644 debian/ironmesh-rendezvous-service.env \
		$(CURDIR)/debian/ironmesh-rendezvous-service/etc/ironmesh/rendezvous-service.env

	install -d $(CLIENT_PACKAGE_ROOT)
	install -m0755 $(PACKAGE_BIN_DIR)/ironmesh $(CLIENT_PACKAGE_ROOT)/ironmesh
	install -m0755 $(PACKAGE_BIN_DIR)/ironmesh-config-app \
		$(CLIENT_PACKAGE_ROOT)/ironmesh-config-app
	install -m0755 $(PACKAGE_BIN_DIR)/ironmesh-background-launcher \
		$(CLIENT_PACKAGE_ROOT)/ironmesh-background-launcher
	install -m0755 $(PACKAGE_BIN_DIR)/ironmesh-folder-agent \
		$(CLIENT_PACKAGE_ROOT)/ironmesh-folder-agent
	install -m0755 $(PACKAGE_BIN_DIR)/ironmesh-os-integration \
		$(CLIENT_PACKAGE_ROOT)/ironmesh-os-integration

	install -d $(CLIENT_EXTENSION_ROOT)
	install -m0644 apps/folder-agent/gnome-shell-extension/ironmesh-status@ironmesh.io/extension.js \
		$(CLIENT_EXTENSION_ROOT)/extension.js
	install -m0644 apps/folder-agent/gnome-shell-extension/ironmesh-status@ironmesh.io/metadata.json \
		$(CLIENT_EXTENSION_ROOT)/metadata.json
	install -m0644 apps/folder-agent/gnome-shell-extension/ironmesh-status@ironmesh.io/stylesheet.css \
		$(CLIENT_EXTENSION_ROOT)/stylesheet.css

	install -d $(CURDIR)/debian/ironmesh-client/usr/bin
	ln -sf ../lib/ironmesh-client/ironmesh \
		$(CURDIR)/debian/ironmesh-client/usr/bin/ironmesh
	ln -sf ../lib/ironmesh-client/ironmesh-config-app \
		$(CURDIR)/debian/ironmesh-client/usr/bin/ironmesh-config-app
	ln -sf ../lib/ironmesh-client/ironmesh-folder-agent \
		$(CURDIR)/debian/ironmesh-client/usr/bin/ironmesh-folder-agent
	ln -sf ../lib/ironmesh-client/ironmesh-os-integration \
		$(CURDIR)/debian/ironmesh-client/usr/bin/ironmesh-os-integration

	install -d $(CURDIR)/debian/ironmesh-client/usr/share/applications
	install -m0644 debian/ironmesh-config-app.desktop \
		$(CURDIR)/debian/ironmesh-client/usr/share/applications/ironmesh-config-app.desktop
	install -d $(CURDIR)/debian/ironmesh-client/etc/xdg/autostart
	install -m0644 debian/ironmesh-config-app-background.desktop \
		$(CURDIR)/debian/ironmesh-client/etc/xdg/autostart/ironmesh-config-app-background.desktop
endif

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --restart-after-upgrade
