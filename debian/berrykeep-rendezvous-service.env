# Copy this file to /etc/berrykeep/rendezvous-service.env or edit it in place,
# then enable the unit with:
#
#   sudo systemctl enable --now berrykeep-rendezvous-service.service
#
# Environment variable names remain compatible with existing Ironmesh
# configuration files during the package-name transition.

# Example:
# IRONMESH_RENDEZVOUS_BIND=0.0.0.0:8443
# IRONMESH_RENDEZVOUS_PUBLIC_URL=https://rendezvous.example.com
# IRONMESH_RELAY_PUBLIC_URLS=https://rendezvous.example.com
# IRONMESH_RENDEZVOUS_PEER_URLS=https://rendezvous-b.example.com
# IRONMESH_RENDEZVOUS_CLIENT_CA_CERT=/etc/berrykeep/client-ca.pem
# IRONMESH_RENDEZVOUS_TLS_CERT=/etc/berrykeep/tls.crt
# IRONMESH_RENDEZVOUS_TLS_KEY=/etc/berrykeep/tls.key
