# Copy this file to /etc/berrykeep/rendezvous-service.env or edit it in place,
# then enable the unit with:
#
#   sudo systemctl enable --now berrykeep-rendezvous-service.service
#
# Use BERRYKEEP_* environment variables for all new configuration.
# The package does not auto-start the service because production deployments
# normally need explicit public URLs and TLS configuration.

# Example:
# BERRYKEEP_RENDEZVOUS_BIND=0.0.0.0:8443
# BERRYKEEP_RENDEZVOUS_PUBLIC_URL=https://rendezvous.example.com
# BERRYKEEP_RELAY_PUBLIC_URLS=https://rendezvous.example.com
# BERRYKEEP_RENDEZVOUS_PEER_URLS=https://rendezvous-b.example.com,https://rendezvous-c.example.com
# BERRYKEEP_RENDEZVOUS_CLIENT_CA_CERT=/etc/berrykeep/client-ca.pem
# BERRYKEEP_RENDEZVOUS_TLS_CERT=/etc/berrykeep/tls.crt
# BERRYKEEP_RENDEZVOUS_TLS_KEY=/etc/berrykeep/tls.key
#
# The endpoint-bound iroh relay is enabled by default on the existing
# Rendezvous origin and port. These optional settings disable or tune it.
# BERRYKEEP_IROH_RELAY_ENABLED=true
# BERRYKEEP_IROH_RELAY_TICKET_TTL_SECS=3600
# BERRYKEEP_IROH_RELAY_CLIENT_RX_BYTES_PER_SECOND=16777216
# BERRYKEEP_IROH_RELAY_CLIENT_RX_MAX_BURST_BYTES=33554432
#
# Set BERRYKEEP_RENDEZVOUS_PEER_URLS to the other public rendezvous base URLs in
# the mesh when you want /control/mesh and client discovery to advertise live
# rendezvous peers beyond the local seed URL.
