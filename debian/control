Build-Profiles: <!server-node-only>
Depends:
 ${misc:Depends},
 ${shlibs:Depends}
Description: BerryKeep standalone rendezvous and relay service
 BerryKeep standalone rendezvous service for advanced deployments where the
 public connectivity service is run separately from the storage nodes.
Breaks: ironmesh-rendezvous-service (<< ${binary:Version})
Replaces: ironmesh-rendezvous-service (<< ${binary:Version})

Package: ironmesh-server-node
Section: oldlibs
Priority: optional
Architecture: any
Depends:
 ${misc:Depends},
 berrykeep-server-node (>= ${source:Upstream-Version})
Description: Transitional package for BerryKeep server node
 This package keeps existing Ironmesh server-node installations upgrading to
 the renamed BerryKeep package. It retains the legacy systemd service and
 configuration paths during the compatibility window.

