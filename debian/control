Package: ironmesh-server-node
Section: net
Architecture: any
Depends:
 ${misc:Depends},
 ${shlibs:Depends}
Description: Ironmesh storage server node
 Ironmesh server node for the distributed storage platform workspace.
 This package ships the `ironmesh-server-node` service binary with the embedded
 server-admin web UI.

Package: ironmesh-server-node-map-tools
Section: net
Architecture: any
Build-Profiles: <!server-node-only>
Depends:
 ${misc:Depends},
 ironmesh-server-node (= ${binary:Version}),
 gdal-bin,
