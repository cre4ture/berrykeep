module(
    name = "berrykeep",
    version = "1.0.38",
)

# Declare platform constraints directly so platform-specific native targets do
# not depend on a transitive repository mapping.
bazel_dep(name = "platforms", version = "1.1.0")

# Rust rules are kept in lock-step with the initial Bazel toolchain. Cargo
# remains the source of truth for third-party dependency versions.
bazel_dep(name = "rules_rust", version = "0.71.3")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
# Keep the C++ compiler driver so it supplies the host system-library paths,
# but use the LLD bundled with the Rust toolchain for Linux x86_64 link steps.
# `RUST_SYSROOT` is expanded by rules_rust when it creates each toolchain.
rust_lld_link_args = {
    "x86_64-unknown-linux-gnu": [
        "--codegen=link-arg=-B$(RUST_SYSROOT)/lib/rustlib/x86_64-unknown-linux-gnu/bin/gcc-ld",
        "--codegen=link-arg=-fuse-ld=lld",
    ],
}
rust.toolchain(
    edition = "2024",
    extra_exec_rustc_flags_triples = rust_lld_link_args,
    extra_rustc_flags_triples = rust_lld_link_args,
    versions = ["1.89.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Crate Universe resolves Cargo metadata while evaluating the module. Pin its
# host tools to the same Rust release as the toolchain so that resolution is
# consistent between developer machines and CI.
host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
host_tools.host_tools(
    name = "berrykeep_rust_host_tools",
    version = "1.89.0",
)
use_repo(host_tools, "berrykeep_rust_host_tools")

# Crate Universe translates the checked-in Cargo workspace and lockfile into
# Bazel targets. Cargo.lock remains the single dependency lockfile during this
# incremental migration.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    host_tools = "@berrykeep_rust_host_tools",
    manifests = ["//:Cargo.toml"],
    # The initial suite runs on GitHub's Linux x86_64 runner. Additional
    # triples are added together with their first native Bazel targets.
    supported_platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")
