<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);ServerNodeExecutable=$(ServerNodeExecutable);ServiceEnvironmentFile=$(ServiceEnvironmentFile)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BerryKeepServerNode.wxs" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
