# This file is read before the BerryKeep Server Node joins the Windows Service
# Control Manager. Restart the "BerryKeep Server Node" service after edits.
#
# Keep the BERRYKEEP_SERVER_NODE_* variables for the guided first-run flow.
# Adding explicit runtime variables such as BERRYKEEP_PUBLIC_URL switches the
# node to the advanced operator path.

# All persistent node state, including cluster credentials, lives here.
BERRYKEEP_SERVER_NODE_DATA_DIR=C:\ProgramData\BerryKeep\ServerNode\data

# The first-run setup UI, normal HTTPS client access, and the initial node
# listener use this address. The MSI creates a local-subnet firewall rule for
# TCP 8443.
BERRYKEEP_SERVER_NODE_BIND=0.0.0.0:8443

# Increase this only when diagnosing a node. The setup and runtime UI retain a
# recent in-memory log buffer as well.
RUST_LOG=info
