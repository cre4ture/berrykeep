# BerryKeep server-node runtime configuration for macOS.
#
# This is an environment file, not a shell script: use exactly KEY=value lines.
# Values are used literally; shell quotes, variable expansion, and command
# substitutions are intentionally not supported.
#
# The installer copies this file to server-node.env only on the first install.
# Existing configuration is retained on package upgrades.

BERRYKEEP_DATA_DIR=/Library/Application Support/BerryKeep/server-node
BERRYKEEP_SERVER_BIND=127.0.0.1:8443

# Set this before exposing the node to other machines, then restart the service.
# BERRYKEEP_SERVER_BIND=0.0.0.0:8443
# BERRYKEEP_PUBLIC_URL=https://node1.example.com
# BERRYKEEP_ADMIN_TOKEN=replace-me

# Optional: increase startup and enrollment diagnostics.
# RUST_LOG=server_node_sdk=debug,info
